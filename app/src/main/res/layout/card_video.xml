<?xml version="1.0" encoding="utf-8"?>
<!-- لوحة المتصفح المثبتة: شريط بحث وعنوان، وشاشة صغيرة لا تطفو ولا تختفي، وتحتها أزرار التكبير والرجوع والبداية وBrave -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- شريط العنوان: بحث في Brave Search أو عنوان موقع -->
    <EditText
        android:id="@+id/video_url"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/chip_bg"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="6dp"
        android:gravity="center_vertical|start"
        android:hint="@string/video_url_hint"
        android:imeOptions="actionGo"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_faint"
        android:textSize="12sp" />

    <FrameLayout
        android:id="@+id/video_slot"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/video_slot_bg"
        android:clipToOutline="true">

        <WebView
            android:id="@+id/video_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- يظهر أثناء القيادة: الصورة مخفية والصوت مستمر -->
        <LinearLayout
            android:id="@+id/video_drive_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2111316"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_drive" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/video_driving"
                android:textColor="@color/ink_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- يظهر إن تعذّر تحميل الصفحة: السبب، والضغط يعيد المحاولة -->
        <TextView
            android:id="@+id/video_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2111316"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/ink_soft"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/video_toggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:background="@drawable/button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_fullscreen" />

            <TextView
                android:id="@+id/video_toggle_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/video_large"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/video_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="0.7"
            android:background="@drawable/button_bg"
            android:contentDescription="@string/video_back"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <ImageView
            android:id="@+id/video_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="0.7"
            android:background="@drawable/button_bg"
            android:contentDescription="@string/video_home"
            android:padding="8dp"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/video_brave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="0.7"
            android:background="@drawable/button_bg"
            android:contentDescription="@string/video_open_brave"
            android:padding="6dp"
            android:src="@drawable/ic_pip" />
    </LinearLayout>
</LinearLayout>
