<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة خريطة مدمجة على هيئة بطاقة الوجهة في التصميم -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/card_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="11dp">

    <!-- وضع «خريطة حية»: خريطة مصغّرة لموقعك، والضغط عليها يفتح التطبيق -->
    <FrameLayout
        android:id="@+id/nav_map"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/video_slot_bg"
        android:visibility="gone">

        <WebView
            android:id="@+id/nav_map_web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <View
            android:id="@+id/nav_map_tap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/nav_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nav_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/app_icon_bg"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_map_placeholder" />

        <LinearLayout
            android:id="@+id/nav_texts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:alpha="0.85"
        android:background="@drawable/bar_traffic" />

    <TextView
        android:id="@+id/nav_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/start_nav"
        android:textColor="@color/orange"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
