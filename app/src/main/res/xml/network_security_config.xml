<?xml version="1.0" encoding="utf-8"?>
<!-- كل الاتصالات مشفّرة (https)، والثقة بشهادات النظام فقط لا بشهادات أضافها مستخدم أو تطبيق آخر -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
