<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- إذن عادي بلا نافذة موافقة: لمعرفة هل حجب الإعلانات (DNS خاص) مفعّل -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- الموقع: لعرض سرعتك الحالية من GPS. يُطلب مرة واحدة، ويعمل التطبيق بدونه -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- تنبيهات الصلاة: إشعار بنغمة (أندرويد ١٣+ يطلب الموافقة)، ومنبّه دقيق في وقت الأذان -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- وضع هدهد: شريط السائق يطفو فوق تطبيق هدهد (يمنحه المستخدم من الإعدادات)، كخدمة أمامية بإشعار هادئ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- أندرويد ١١ فما فوق: رؤية التطبيقات التي لها أيقونة فقط (لعرضها وفتحها)، ولا شيء غيرها -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- محرّك النطق في الجهاز، لقراءة تنبيهات الصلاة بصوت (أندرويد ١١+ يحتاج هذا التصريح) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- الأمان:
         allowBackup=false + القواعد: لا تُنسخ الإعدادات خارج الجهاز
         usesCleartextTraffic=false: لا اتصال غير مشفّر، كل الاتصالات https
         taskAffinity="" للشاشات الداخلية: لا يستطيع تطبيق آخر أن يندسّ في مهمتها -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/CarTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <activity
            android:name=".PrayerActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
        <!-- مستقبِل منبّه الصلاة: غير مكشوف، لا يستقبل إلا من منبّه التطبيق نفسه -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Car launcher driver rail floating over the navigation app" />
        </service>

        <receiver
            android:name=".PrayerAlerts"
            android:exported="false" />
    </application>
</manifest>
