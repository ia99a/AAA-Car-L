<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- إذن عادي بلا نافذة موافقة: لمعرفة هل حجب الإعلانات (DNS خاص) مفعّل -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- أندرويد ١١ فما فوق: رؤية التطبيقات التي لها أيقونة فقط (لعرضها وفتحها)، ولا شيء غيرها -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- الأمان:
         allowBackup=false + القواعد: لا تُنسخ الإعدادات خارج الجهاز
         usesCleartextTraffic=false: لا اتصال غير مشفّر (التطبيق أصلًا بلا إذن إنترنت)
         taskAffinity="" للشاشات الداخلية: لا يستطيع تطبيق آخر أن يندسّ في مهمتها -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/CarTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AppsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <activity
            android:name=".PrayerActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true" />
    </application>
</manifest>
